@deviceId = 11111111-1111-4111-8111-000000000001

### Register a new account
POST {{Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "demo@pulsetech.local",
  "password": "Sup3rSecret!"
}

###

### Login (captures the access token for the requests below)
# @name login
POST {{Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@pulsetech.local",
  "password": "Sup3rSecret!"
}

> {% client.global.set("accessToken", response.body.accessToken); %}

###

### Current user (any authenticated role)
GET {{Api_HostAddress}}/api/me
Authorization: Bearer {{accessToken}}

###

### Admin-only endpoint (403 unless role = Admin)
GET {{Api_HostAddress}}/api/admin/ping
Authorization: Bearer {{accessToken}}

###

### List MY devices (optional filters: appId, isActive, limit, offset)
GET {{Api_HostAddress}}/api/devices?limit=50&isActive=true
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### Get one of my devices
GET {{Api_HostAddress}}/api/devices/{{deviceId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### Create a device (owner = current user, taken from the token)
POST {{Api_HostAddress}}/api/devices
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Living room pot",
  "appId": null,
  "isActive": true
}

###

### Update a device (full replace)
PUT {{Api_HostAddress}}/api/devices/{{deviceId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Renamed pot",
  "isActive": false,
  "appId": null
}

###

### Delete a device
DELETE {{Api_HostAddress}}/api/devices/{{deviceId}}
Authorization: Bearer {{accessToken}}

###

### List telemetry for one of my devices over a period
POST {{Api_HostAddress}}/api/devices/{{deviceId}}/telemetry/query
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "from": "2026-01-01T00:00:00Z",
  "to": "2026-01-02T00:00:00Z"
}

###

### Last 24 hours (from/to omitted), capped to 500 rows
POST {{Api_HostAddress}}/api/devices/{{deviceId}}/telemetry/query
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "limit": 500
}

###
